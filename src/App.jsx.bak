              />
              <div className="min-w-0">
                <span className="font-bold text-xs sm:text-sm text-signal-dark block truncate">
                  {clientReviews[activeReviewIndex].name}
                </span>
                <span className="text-[11px] sm:text-xs font-mono text-signal-muted block truncate">
