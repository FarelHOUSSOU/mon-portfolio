      >
        <div className="max-w-md mx-auto">
          {/* Ligne 1 : Marque Farel Houssou + Bouton WhatsApp direct */}
          <div className="flex items-center justify-between gap-2 pt-1">
            <a href="#" className="flex items-center gap-1.5 shrink-0" aria-label="Accueil">
              <Code2 className="w-5 h-5 text-signal-blue shrink-0" />
              <span className="font-sans font-black text-sm tracking-tight text-signal-dark whitespace-nowrap">
                Farel Houssou
              </span>
            </a>

            <button
              onClick={() => openWhatsAppWith(defaultHeroMessage)}
              className="flex items-center gap-1.5 bg-emerald-600 hover:bg-emerald-500 text-white text-[11px] font-mono font-bold px-3 py-1.5 rounded-full shadow-sm active:scale-95 transition-transform shrink-0"
