          {/* Moitié basse */}
          <div className="preloader-bottom absolute inset-x-0 bottom-0 h-1/2 bg-signal-paper flex items-start justify-center pt-4">
            {/* Particules basses */}
            <div className="absolute inset-0 overflow-hidden pointer-events-none">
