              />
            </div>
            <span className="mt-3 font-mono text-xs text-white/70 tracking-widest">
              {preloaderProgress}%
            </span>
          </div>
        </div>
      )}

      {/* HEADER DESKTOP (Top) — Conforme aux exigences du prompt 2 & 3 */}
      <header
        className={`hidden md:block fixed top-4 left-1/2 -translate-x-1/2 z-50 transition-all duration-300 w-[94%] max-w-5xl rounded-full ${
          navScrolled
            ? 'bg-signal-bg/90 backdrop-blur-xl border border-signal-border shadow-signal-card py-2.5 px-6'
            : 'bg-transparent py-4 px-2'
        }`}
      >
        <div className="flex items-center justify-between gap-4">
          {/* Icône Code + Farel Houssou en noir */}
          <div className="flex items-center gap-3 shrink-0">
            <a href="#" className="flex items-center gap-2 group interactive-lift" aria-label="Accueil">
