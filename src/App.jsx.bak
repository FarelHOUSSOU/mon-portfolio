          <div className="flex items-center gap-1 text-amber-500 mb-3 sm:mb-4">
            {[...Array(clientReviews[activeReviewIndex].rating)].map((_, i) => (
              <Star key={i} className="w-3.5 h-3.5 sm:w-4 sm:h-4 fill-amber-500" />
            ))}
          </div>

          <p className="text-xs sm:text-base md:text-lg text-signal-dark font-sans italic leading-relaxed mb-5 sm:mb-6">
