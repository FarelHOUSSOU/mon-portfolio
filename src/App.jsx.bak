                      <span>{project.title}</span>
                      <ArrowUpRight className="w-5 h-5 text-signal-blue group-hover:translate-x-1 group-hover:-translate-y-1 transition-transform" />
                    </h3>
                    <p className="text-xs sm:text-sm font-mono text-signal-blue font-semibold mt-1">
                      {project.subtitle}
