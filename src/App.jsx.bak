                    ))}
                  </div>

                  <div className="pt-2">
                    <button
                      type="button"
                      className="text-xs font-mono font-bold text-signal-blue hover:text-signal-blueHover flex items-center gap-1"
                    >
                      <span>Voir le détail complet et les liens</span>
                      <ChevronRight className="w-3.5 h-3.5" />
                    </button>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>

      {/* MODAL / DÉTAIL DU PROJET AU CLIC (Inspiré fidèlement d'Aquidev - Consigne 1) */}
      {activeProjectDetail && (
        <div
          className="fixed inset-0 z-[99998] flex items-center justify-center p-3 sm:p-4 bg-signal-dark/70 backdrop-blur-md animate-fadeIn"
          onClick={() => setActiveProjectDetail(null)}
        >
          <div
            className="bg-signal-card border border-signal-border rounded-[2rem] sm:rounded-[2.5rem] p-5 sm:p-8 lg:p-10 max-w-2xl w-full shadow-2xl relative max-h-[88dvh] overflow-y-auto animate-scaleUp text-left my-auto"
            onClick={(e) => e.stopPropagation()}
          >
            {/* Close button with rotation on hover (Aquidev style) */}
            <button
              onClick={() => setActiveProjectDetail(null)}
              className="absolute top-4 right-4 sm:top-5 sm:right-5 w-9 h-9 sm:w-10 sm:h-10 rounded-full bg-signal-dark text-white hover:rotate-90 flex items-center justify-center transition-transform duration-300 shadow-md z-10"
              aria-label="Fermer le détail"
            >
              <X className="w-4 h-4 sm:w-5 sm:h-5" />
            </button>

            {/* Tag & Title */}
            <div className="pr-10">
              <span className="font-mono text-[10px] sm:text-xs font-bold text-signal-blue uppercase bg-signal-paper px-2.5 py-0.5 sm:px-3 sm:py-1 rounded-full border border-signal-border inline-block mb-2 sm:mb-3">
                {activeProjectDetail.tag}
              </span>
              <h3 className="font-drama italic text-2xl sm:text-4xl text-signal-dark leading-tight">
                {activeProjectDetail.title}
              </h3>
              <p className="font-mono text-xs text-signal-muted font-bold mt-1">
                {activeProjectDetail.subtitle}
              </p>
            </div>

            {/* Project Image */}
            <div className="my-4 sm:my-6 rounded-2xl overflow-hidden border border-signal-border bg-signal-paper">
              <img
                src={activeProjectDetail.image}
                alt={activeProjectDetail.title}
                className="w-full h-auto object-cover max-h-52 sm:max-h-60"
              />
            </div>

            {/* Description détaillée */}
            <div className="space-y-3 sm:space-y-4 text-xs sm:text-sm text-signal-dark leading-relaxed font-sans">
              <p>{activeProjectDetail.fullDescription}</p>
            </div>

            {/* Stack Pills */}
            <div className="mt-4 sm:mt-5 pt-4 border-t border-signal-border">
              <span className="text-[10px] sm:text-[11px] font-mono text-signal-muted uppercase block mb-2 font-bold">
