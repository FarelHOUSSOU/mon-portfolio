            >
              <span className="relative flex h-1.5 w-1.5">
                <span className="animate-ping absolute inline-flex h-full w-full rounded-full bg-white opacity-75"></span>
                <span className="relative inline-flex rounded-full h-1.5 w-1.5 bg-white"></span>
              </span>
              <MessageCircle className="w-3.5 h-3.5" />
              <span>WhatsApp</span>
            </button>
          </div>

          {/* Ligne 2 : Liens de navigation segmentés (anti-retour à la ligne) */}
          <div className="flex items-center justify-between gap-1 bg-signal-paper/90 border border-signal-border px-1.5 py-1 rounded-full text-[11px] font-mono font-bold text-signal-dark mt-2 shadow-xs">
            <a
              href="#projets"
              className="flex-1 text-center py-1 px-1.5 rounded-full hover:text-signal-blue active:bg-signal-card transition-colors whitespace-nowrap"
            >
              Projets
            </a>
            <span className="text-signal-border/80 select-none">•</span>
            <a
              href="#apropos"
              className="flex-1 text-center py-1 px-1.5 rounded-full hover:text-signal-blue active:bg-signal-card transition-colors whitespace-nowrap"
            >
              À propos
            </a>
            <span className="text-signal-border/80 select-none">•</span>
            <a
              href="#formations"
              className="flex-1 text-center py-1 px-1.5 rounded-full hover:text-signal-blue active:bg-signal-card transition-colors whitespace-nowrap"
            >
              Formations
            </a>
          </div>
        </div>
      </nav>

      {/* SECTION HERO — Parfaitement proportionnée sur mobile (suppression du vide vertical 88dvh) */}
      <section className="relative flex flex-col items-center justify-center text-center px-4 pt-24 pb-8 sm:pt-36 sm:pb-16 sm:min-h-[75dvh]">
        <div className="max-w-3xl mx-auto flex flex-col items-center w-full">
          {/* Punchline unique */}
          <h1 className="hero-punchline text-2xl sm:text-4xl md:text-5xl lg:text-6xl font-black tracking-tight text-signal-dark leading-[1.25] sm:leading-[1.15] max-w-2xl px-2">
            Je transforme vos idées en solutions web qui créent de la valeur.
          </h1>

          {/* CTAs Stratégiques */}
          <div className="flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-4 mt-6 sm:mt-10 w-full sm:w-auto">
            <a
              href="#projets"
              className="hero-cta btn-magnetic flex items-center justify-center gap-2 bg-signal-blue hover:bg-signal-blueHover text-white font-medium px-6 sm:px-8 py-3 sm:py-3.5 rounded-full shadow-signal-blue text-xs sm:text-sm tracking-wide w-full max-w-xs sm:max-w-none sm:w-auto"
            >
              <Code2 className="w-4 h-4" />
              <span>Découvrir mes projets</span>
            </a>
            <button
              onClick={() => openWhatsAppWith(defaultHeroMessage)}
              className="hero-cta btn-magnetic flex items-center justify-center gap-2 bg-emerald-600 hover:bg-emerald-700 text-white font-medium px-6 sm:px-8 py-3 sm:py-3.5 rounded-full text-xs sm:text-sm tracking-wide w-full max-w-xs sm:max-w-none sm:w-auto transition-all shadow-sm"
            >
              <MessageCircle className="w-4 h-4" />
              <span>M'écrire sur WhatsApp</span>
            </button>
          </div>
        </div>
      </section>

      {/* SECTION PROJETS — Avec interaction au clic inspirée d'Aquidev (Consigne 1) */}
      <section id="projets" className="section-reveal scroll-mt-24 sm:scroll-mt-28 py-8 sm:py-20 px-4 sm:px-6 lg:px-8 max-w-6xl mx-auto">
