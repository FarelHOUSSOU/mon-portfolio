                    {t}
                  </span>
                ))}
              </div>
            </div>

            {/* Actions : Lien GitHub réel + WhatsApp */}
            <div className="mt-6 sm:mt-8 pt-4 sm:pt-5 border-t border-signal-border flex flex-col sm:flex-row gap-2.5 sm:gap-3">
              {/* Lien GitHub vérifié */}
              <a
                href={activeProjectDetail.githubUrl}
                target="_blank"
                rel="noopener noreferrer"
                className="btn-magnetic flex-1 flex items-center justify-center gap-2 bg-signal-dark hover:bg-signal-slate text-white text-xs font-mono font-semibold py-3 px-4 rounded-xl shadow-sm transition-colors"
              >
                <Github className="w-4 h-4" />
                <span>Code Source GitHub</span>
                <ExternalLink className="w-3.5 h-3.5 text-gray-400" />
              </a>

              {/* Bouton "Le même pour moi" */}
              <button
                onClick={() => {
                  setActiveProjectDetail(null);
                  openWhatsAppWith(activeProjectDetail.customRequestMessage);
                }}
                className="btn-magnetic flex-1 flex items-center justify-center gap-2 bg-signal-blue hover:bg-signal-blueHover text-white text-xs font-mono font-semibold py-3 px-4 rounded-xl shadow-signal-blue transition-colors"
              >
                <Sparkles className="w-4 h-4" />
                <span>Le même pour moi</span>
              </button>

              {/* WhatsApp direct */}
              <button
                onClick={() => {
                  setActiveProjectDetail(null);
                  openWhatsAppWith(`Bonjour Farel, je vous contacte concernant votre projet ${activeProjectDetail.title}. J’aimerais échanger avec vous.`);
                }}
                className="btn-magnetic sm:w-auto flex items-center justify-center gap-2 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-mono font-semibold py-3 px-4 rounded-xl shadow-sm transition-colors"
              >
                <MessageCircle className="w-4 h-4" />
                <span>WhatsApp</span>
              </button>
            </div>
          </div>
        </div>
      )}

      {/* SECTION À PROPOS — Sans aucun pattern générique d'IA (Consigne 6) */}
