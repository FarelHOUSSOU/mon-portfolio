              <div className="preloader-particle absolute w-1.5 h-1.5 rounded-full bg-white/25 top-[20%] left-[40%] animate-float-fast" />
              <div className="preloader-particle absolute w-2.5 h-2.5 rounded-full bg-white/10 top-[40%] left-[85%] animate-float-slow" />
              <div className="preloader-particle absolute w-1 h-1 rounded-full bg-white/30 top-[10%] left-[55%] animate-float-medium" />
            </div>
