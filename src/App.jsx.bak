                  </li>
                  <li className="flex items-start gap-2">
                    <ChevronRight className="w-4 h-4 text-signal-blue shrink-0 mt-0.5" />
                    <span>Gestion de code source et processus de déploiement (Vercel, Railway, Render).</span>
                  </li>
                </ul>
              </div>
            </div>
          )}

          {/* Onglet 3 : Compétences concrètes (Sans barres de progression basiques) */}
          {activeAboutTab === 'competences' && (
