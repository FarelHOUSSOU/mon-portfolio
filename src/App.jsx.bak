            {/* Navigation boutons */}
            <div className="flex items-center gap-1.5 sm:gap-2 shrink-0">
              <button
                onClick={() =>
                  setActiveReviewIndex((prev) => (prev === 0 ? clientReviews.length - 1 : prev - 1))
                }
                className="w-8 h-8 sm:w-9 sm:h-9 rounded-full bg-signal-paper hover:bg-signal-dark hover:text-white flex items-center justify-center transition-colors"
                aria-label="Avis précédent"
              >
                <ChevronLeft className="w-4 h-4" />
              </button>
              <button
                onClick={() =>
                  setActiveReviewIndex((prev) => (prev === clientReviews.length - 1 ? 0 : prev + 1))
                }
                className="w-8 h-8 sm:w-9 sm:h-9 rounded-full bg-signal-paper hover:bg-signal-dark hover:text-white flex items-center justify-center transition-colors"
                aria-label="Avis suivant"
              >
                <ChevronRight className="w-4 h-4" />
              </button>
            </div>
          </div>
        </div>
      </section>

      {/* SECTION "ET LE VÔTRE ?" — Disposition exacte Aquidev (Grille 2 colonnes sur mobile) */}
      <section className="section-reveal py-8 sm:py-16 px-4 sm:px-6 lg:px-8 max-w-5xl mx-auto">
        <div className="bg-signal-dark text-white rounded-[2rem] sm:rounded-[3rem] p-5 sm:p-10 lg:p-14 relative overflow-hidden shadow-2xl">
          <div className="max-w-2xl mx-auto text-center mb-6 sm:mb-10">
            <h2 className="font-drama italic text-3xl sm:text-5xl md:text-6xl text-white leading-tight">
              Et le <span className="font-drama italic underline decoration-signal-blue decoration-2 underline-offset-4">vôtre</span>&nbsp;?
            </h2>
            <p className="text-xs sm:text-base text-gray-300 font-sans leading-relaxed mt-2.5 sm:mt-3">
              Quel type de projet souhaitez-vous concrétiser ? Sélectionnez une typologie ci-dessous pour lancer l'échange sur WhatsApp.
            </p>
          </div>

          {/* Grille des services — 2 COLONNES SUR MOBILE (Disposition exacte capture Aquidev) */}
          <div className="grid grid-cols-2 lg:grid-cols-3 gap-2.5 sm:gap-4 mb-6 sm:mb-8">
            {serviceOptions.map((opt) => {
              const IconComp = opt.icon;
              const isSelected = selectedService === opt.key;
              return (
                <button
                  key={opt.key}
                  onClick={() => setSelectedService(opt.key)}
                  className={`text-left p-3.5 sm:p-5 rounded-2xl sm:rounded-3xl border transition-all flex flex-col justify-between h-24 sm:h-28 active:scale-95 ${
                    isSelected
                      ? 'bg-signal-blue/25 border-signal-blue text-white shadow-signal-blue ring-2 ring-signal-blue/40'
                      : 'bg-white/5 border-white/10 text-gray-300 hover:bg-white/10 hover:border-white/20'
                  }`}
                >
                  {/* Titre en haut à gauche */}
                  <span className="font-bold text-sm sm:text-base text-white tracking-tight">
                    {opt.shortTitle}
                  </span>

                  {/* Icône en bas à gauche */}
                  <div className={`p-1.5 sm:p-2 rounded-xl w-fit ${isSelected ? 'bg-signal-blue text-white' : 'bg-white/10 text-gray-300'}`}>
                    <IconComp className="w-4 h-4 sm:w-5 sm:h-5" />
                  </div>
                </button>
              );
            })}
          </div>

          {/* CTA Contextuel WhatsApp */}
          <div className="p-4 sm:p-6 rounded-[1.5rem] sm:rounded-[2rem] bg-white/5 border border-white/10 text-center max-w-xl mx-auto space-y-2.5 sm:space-y-3">
            <span className="text-[11px] sm:text-xs font-mono text-signal-blueLight uppercase block">
              // Projet sélectionné : <strong className="text-white">{currentService.title}</strong>
            </span>
            <button
              onClick={() => openWhatsAppWith(currentService.whatsappText)}
              className="btn-magnetic w-full flex items-center justify-center gap-2 bg-emerald-600 hover:bg-emerald-500 text-white font-mono font-semibold px-5 sm:px-6 py-3 sm:py-3.5 rounded-full text-xs sm:text-sm shadow-lg transition-all"
            >
              <MessageCircle className="w-4 h-4 sm:w-5 sm:h-5" />
              <span>Démarrer ce projet sur WhatsApp</span>
            </button>
            <p className="text-[10px] sm:text-[11px] font-mono text-gray-400">
              Disponible immédiatement • Réponse garantie sous 24h
            </p>
          </div>
        </div>
      </section>

      {/* SECTION FORMATIONS (Navigation #formations) */}
      <section id="formations" className="section-reveal scroll-mt-24 sm:scroll-mt-28 py-8 sm:py-16 px-4 sm:px-6 lg:px-8 max-w-5xl mx-auto">
        <div className="bg-signal-card border border-signal-border rounded-[2rem] sm:rounded-[3rem] p-4 sm:p-8 lg:p-12 shadow-signal-card">
          <div className="text-center max-w-2xl mx-auto mb-6 sm:mb-10">
            <h2 className="font-drama italic text-3xl sm:text-5xl md:text-6xl text-signal-dark">
              Formations
            </h2>
            <p className="text-xs sm:text-sm text-signal-muted mt-1.5 sm:mt-2 font-mono">
              Parcours de formation et compétences linguistiques
            </p>
          </div>

          <div className="space-y-4 sm:space-y-5">
            {/* Licence Pro SIL 2026 */}
            <div className="p-4 sm:p-6 lg:p-8 rounded-[1.5rem] sm:rounded-[2rem] bg-signal-paper border border-signal-border flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
              <div className="flex items-start gap-3 sm:gap-4">
                <div className="p-3 rounded-2xl bg-signal-blue text-white shadow-signal-blue shrink-0">
                  <GraduationCap className="w-5 h-5 sm:w-6 sm:h-6" />
                </div>
                <div>
                  <span className="font-mono text-xs text-signal-blue font-bold">2026</span>
                  <h3 className="text-base sm:text-xl font-bold text-signal-dark mt-0.5">
                    Licence Professionnelle en Informatique
                  </h3>
                  <p className="text-xs sm:text-sm font-mono text-signal-muted font-semibold">
                    Spécialité Systèmes d’Information et Logiciels (SIL)
                  </p>
                  <p className="text-xs text-signal-muted mt-1 font-sans">
                    ESCAE de Calavi, Bénin — Conception logicielle, bases relationnelles, architectures applicatives.
                  </p>
                </div>
              </div>
              <span className="inline-flex items-center text-[11px] sm:text-xs font-mono px-3.5 py-1 rounded-full bg-signal-dark text-white font-semibold self-start sm:self-auto shrink-0">
                Diplômé 2026
              </span>
            </div>

            {/* Baccalauréat 2021 */}
            <div className="p-4 sm:p-6 lg:p-8 rounded-[1.5rem] sm:rounded-[2rem] bg-signal-paper border border-signal-border flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
              <div className="flex items-start gap-3 sm:gap-4">
                <div className="p-3 rounded-2xl bg-signal-dark text-white shrink-0">
                  <Award className="w-5 h-5 sm:w-6 sm:h-6" />
                </div>
                <div>
                  <span className="font-mono text-xs text-signal-blue font-bold">2021</span>
                  <h3 className="text-base sm:text-xl font-bold text-signal-dark mt-0.5">
                    Baccalauréat Série B
                  </h3>
                  <p className="text-xs sm:text-sm font-mono text-signal-muted font-semibold">
                    Mention Assez Bien
                  </p>
                  <p className="text-xs text-signal-muted mt-1 font-sans">
                    Bases solides en mathématiques appliquées, raisonnement logique et sciences économiques.
                  </p>
                </div>
              </div>
              <span className="inline-flex items-center text-[11px] sm:text-xs font-mono px-3.5 py-1 rounded-full bg-white text-signal-dark border border-signal-border self-start sm:self-auto shrink-0">
                Mention Assez Bien
              </span>
            </div>

            {/* Langues & Football */}
            <div className="grid grid-cols-1 md:grid-cols-2 gap-3 sm:gap-4">
              <div className="p-4 sm:p-6 rounded-[1.5rem] sm:rounded-[2rem] bg-signal-paper border border-signal-border">
                <h4 className="font-bold text-xs font-mono uppercase text-signal-dark mb-2.5">
                  🌐 Langues
                </h4>
                <div className="space-y-2 text-xs font-mono">
                  <div className="flex justify-between border-b border-signal-border/50 pb-1.5">
                    <span>Français</span>
                    <span className="text-signal-blue font-bold">Langue maternelle / Courant</span>
                  </div>
                  <div className="flex justify-between">
                    <span>Anglais</span>
                    <span className="text-signal-blue font-bold">Technique & Professionnel</span>
                  </div>
                </div>
              </div>

              <div className="p-4 sm:p-6 rounded-[1.5rem] sm:rounded-[2rem] bg-signal-paper border border-signal-border">
                <h4 className="font-bold text-xs font-mono uppercase text-signal-dark mb-2.5">
                  ⚽ Centre d’intérêt
                </h4>
                <p className="text-xs text-signal-muted leading-relaxed font-sans">
                  Pratique active du football : esprit d’équipe, vision tactique collective et réactivité sous pression.
                </p>
              </div>
            </div>
          </div>
        </div>
      </section>

      {/* FOOTER STRICTEMENT CONFORME AU POINT 7 DU PROMPT */}
      {/* "Afficher uniquement :
          Farel Houssou — Tous droits réservés
          GitHub : https://github.com/FarelHOUSSOU
          Instagram : https://www.instagram.com/farelhoussou?obrf=MW1na3JkZ3d6eXFzNw%3D%3D&utm_source=qr
          Aucun autre élément." */}
      <footer className="bg-signal-dark text-signal-paper py-10 px-4 sm:px-6 lg:px-8 mt-12 rounded-t-[3rem] border-t border-signal-dark safe-pb-mobile">
        <div className="max-w-4xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-4 text-center sm:text-left text-xs font-mono">
          <div>
            Farel Houssou — Tous droits réservés
          </div>
          <div className="flex flex-col sm:flex-row items-center gap-4">
            <a
              href="https://github.com/FarelHOUSSOU"
              target="_blank"
              rel="noopener noreferrer"
              className="hover:text-signal-blueLight transition-colors flex items-center gap-1.5"
            >
              <Github className="w-3.5 h-3.5" />
              <span>GitHub : FarelHOUSSOU</span>
            </a>
            <a
              href="https://www.instagram.com/farelhoussou?obrf=MW1na3JkZ3d6eXFzNw%3D%3D&utm_source=qr"
              target="_blank"
              rel="noopener noreferrer"
              className="hover:text-signal-blueLight transition-colors flex items-center gap-1.5"
            >
              <Instagram className="w-3.5 h-3.5" />
              <span>Instagram : farelhoussou</span>
            </a>
          </div>
        </div>
      </footer>

      {/* MODAL / INTERFACE ANIMÉE WHATSAPP (Consigne 2 & 8) — Responsive, accessible sur mobile */}
      {whatsAppModalOpen && (
        <div
          className="fixed inset-0 z-[99999] flex items-center justify-center p-3 sm:p-4 bg-signal-dark/60 backdrop-blur-md animate-fadeIn"
          onClick={() => setWhatsAppModalOpen(false)}
        >
          <div
            className="bg-signal-card border border-signal-border rounded-[2rem] sm:rounded-[2.5rem] p-5 sm:p-8 max-w-md w-full shadow-2xl relative max-h-[88dvh] overflow-y-auto animate-scaleUp text-left my-auto"
            onClick={(e) => e.stopPropagation()}
          >
            {/* Close button */}
            <button
              onClick={() => setWhatsAppModalOpen(false)}
              className="absolute top-4 right-4 sm:top-5 sm:right-5 w-9 h-9 sm:w-10 sm:h-10 rounded-full bg-signal-paper hover:bg-signal-dark hover:text-white flex items-center justify-center transition-colors z-10"
              aria-label="Fermer"
            >
              <X className="w-4 h-4" />
            </button>

            {/* Header Modal */}
            <div className="flex items-center gap-3 sm:gap-3.5 mb-4 sm:mb-5 pr-8">
              <div className="relative">
                <div className="w-10 h-10 sm:w-11 sm:h-11 rounded-full bg-signal-dark text-signal-bg flex items-center justify-center font-mono font-bold text-xs shrink-0">
                  FH
                </div>
                <span className="absolute bottom-0 right-0 w-3 h-3 rounded-full bg-emerald-500 border-2 border-white" />
              </div>
              <div>
                <h3 className="font-bold text-sm sm:text-base text-signal-dark">
                  Farel HOUSSOU
                </h3>
                <span className="text-xs font-mono text-emerald-600 flex items-center gap-1">
                  En ligne • WhatsApp direct
                </span>
              </div>
            </div>

            <p className="text-xs text-signal-muted leading-relaxed font-sans mb-3 sm:mb-4">
              Discutez directement avec Farel sur WhatsApp avec votre besoin prérempli.
            </p>

            {/* Message preview box */}
            <div className="p-3 sm:p-3.5 rounded-2xl bg-signal-paper border border-signal-border font-mono text-xs text-signal-dark mb-4 sm:mb-5">
              <span className="text-[10px] uppercase text-signal-muted block mb-1 font-bold">
                // Message prérempli :
              </span>
              « {whatsAppMessage} »
            </div>

            {/* Action */}
            <div className="space-y-2">
              <a
                href={getWhatsAppLink(whatsAppMessage)}
                target="_blank"
                rel="noopener noreferrer"
                onClick={() => setWhatsAppModalOpen(false)}
                className="btn-magnetic w-full flex items-center justify-center gap-2 bg-emerald-600 hover:bg-emerald-700 text-white font-mono font-semibold py-3 px-4 rounded-xl text-xs shadow-md transition-colors"
              >
                <MessageCircle className="w-4 h-4" />
                <span>M’écrire sur WhatsApp</span>
              </a>

              <button
                onClick={() => setWhatsAppModalOpen(false)}
                className="w-full py-2 text-xs font-mono text-signal-muted hover:text-signal-dark transition-colors"
              >
                Fermer
              </button>
            </div>
          </div>
        </div>
      )}
    </div>
  );
}
