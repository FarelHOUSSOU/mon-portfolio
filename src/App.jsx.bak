            <div className="space-y-6">
              {/* Expérience 1 : Stage CITECH Sarl */}
              <div className="p-6 sm:p-8 rounded-[2rem] bg-signal-paper border border-signal-border">
                <div className="flex flex-wrap items-center justify-between gap-2 mb-2">
                  <span className="font-mono text-xs text-signal-blue font-bold bg-white px-3 py-1 rounded-full border border-signal-border">
