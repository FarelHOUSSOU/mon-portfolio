import React, { useEffect, useRef, useState } from 'react';
import gsap from 'gsap';
import { ScrollTrigger } from 'gsap/ScrollTrigger';
import {
  Github,
  Instagram,
  MapPin,
  ExternalLink,
  Code2,
  Cpu,
  Layers,
  Database,
  Terminal,
  ArrowUpRight,
  GraduationCap,
  Award,
  ChevronRight,
  ShieldCheck,
  MessageCircle,
  X,
  Star,
  Quote,
  Sparkles,
  ChevronLeft,
  Smartphone,
  ShoppingBag,
  Monitor,
  CheckCircle2,
  Zap,
  Check,
  FolderGit2,
  User,
  Info,
  Mail,
  Phone,
  ArrowUp
} from 'lucide-react';

gsap.registerPlugin(ScrollTrigger);

// Numéro WhatsApp de contact
const WHATSAPP_NUMBER = "22900000000";

const defaultHeroMessage = "Bonjour Farel, je vous contacte concernant un projet de développement web. J’aimerais vous présenter mon besoin.";

export default function App() {
  const containerRef = useRef(null);
  const [navScrolled, setNavScrolled] = useState(false);
  const [introFinished, setIntroFinished] = useState(false);
  const [preloaderText, setPreloaderText] = useState('');
  const [preloaderProgress, setPreloaderProgress] = useState(0);
  
  // WhatsApp modal state
  const [whatsAppModalOpen, setWhatsAppModalOpen] = useState(false);
  const [whatsAppMessage, setWhatsAppMessage] = useState(defaultHeroMessage);
  
  // Project detail modal state (Aquidev inspired card click interaction)
  const [activeProjectDetail, setActiveProjectDetail] = useState(null);

  // À propos tab state
  const [activeAboutTab, setActiveAboutTab] = useState('bio'); // 'bio' | 'experiences' | 'competences'

  // Avis clients interactifs
  const [activeReviewIndex, setActiveReviewIndex] = useState(0);

  // Section "Et le vôtre ?" service selection
  const [selectedService, setSelectedService] = useState('saas');

  const getWhatsAppLink = (message) => {
    return `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(message)}`;
  };

  const openWhatsAppWith = (msg) => {
    setWhatsAppMessage(msg);
    setWhatsAppModalOpen(true);
  };

  // Preloader d'intro interactif — bleu + papier, animé et vivant
  useEffect(() => {
    const fullText = "farelhoussou.dev";
    let currentIndex = 0;
    let progress = 0;

    const textInterval = setInterval(() => {
      if (currentIndex <= fullText.length) {
        setPreloaderText(fullText.slice(0, currentIndex));
        currentIndex++;
      } else {
        clearInterval(textInterval);
      }
    }, 55);

    const progressInterval = setInterval(() => {
      progress += Math.random() * 8 + 2;
      if (progress >= 100) {
        progress = 100;
        setPreloaderProgress(100);
        clearInterval(progressInterval);
        setTimeout(() => {
          // Split reveal: two halves slide away
          gsap.to('.preloader-top', {
            yPercent: -100,
            duration: 0.8,
            ease: 'power4.inOut'
          });
          gsap.to('.preloader-bottom', {
            yPercent: 100,
            duration: 0.8,
            ease: 'power4.inOut',
            onComplete: () => setIntroFinished(true)
          });
        }, 400);
      } else {
        setPreloaderProgress(Math.min(Math.round(progress), 99));
      }
    }, 80);

    return () => {
      clearInterval(textInterval);
      clearInterval(progressInterval);
    };
  }, []);

  // Détection du scroll pour le header desktop
  useEffect(() => {
    const handleScroll = () => {
      if (window.scrollY > 40) {
        setNavScrolled(true);
      } else {
        setNavScrolled(false);
      }
    };
    window.addEventListener('scroll', handleScroll, { passive: true });
    return () => window.removeEventListener('scroll', handleScroll);
  }, []);

  // GSAP Animations
  useEffect(() => {
    if (!introFinished) return;

    const ctx = gsap.context(() => {
      // Hero reveal
      const heroTl = gsap.timeline({ defaults: { ease: 'power3.out' } });
      heroTl
        .from('.hero-punchline', { opacity: 0, y: 30, duration: 0.9 })
        .from('.hero-cta', { opacity: 0, y: 12, stagger: 0.1, duration: 0.5 }, '-=0.3');

      // Sections reveal
      gsap.utils.toArray('.section-reveal').forEach((sec) => {
        gsap.from(sec, {
          scrollTrigger: {
            trigger: sec,
            start: 'top 85%',
            toggleActions: 'play none none none'
          },
          opacity: 0,
          y: 28,
          duration: 0.8,
          ease: 'power3.out'
        });
      });
    }, containerRef);

    return () => ctx.revert();
  }, [introFinished]);

  // Données des projets (LandSafe en premier avec capture réelle)
  const projects = [
    {
      id: 'landsafe',
      title: 'LandSafe',
      subtitle: 'Sécurisation & Analyse du Risque Foncier',
      tag: 'PROJET PHARE // BÉNIN',
      shortPitch: 'Plateforme destinée à renforcer la traçabilité et la vérification des parcelles foncières au Bénin, avec indicateurs de risque et audit documentaire.',
      fullDescription: "Conçue pour répondre aux défis majeurs de litiges et d'insécurité foncière au Bénin, LandSafe centralise les informations relatives aux parcelles, vérifie l'authenticité des actes et évalue les facteurs de risque avant toute transaction. Le projet implémente une architecture Laravel MVC rigoureuse couplée à une modélisation relationnelle MySQL avec intégrité des données.",
      image: '/landsafe.png',
      technologies: ['Laravel', 'MySQL', 'JavaScript', 'Architecture MVC', 'Requêtes SQL Avancées'],
      githubUrl: 'https://github.com/FarelHOUSSOU/Landsafe',
      hasLiveSite: false, // Pas de faux bouton "Voir le site", conformément aux consignes
      customRequestMessage: 'Bonjour Farel, j’ai découvert votre projet LandSafe et j’aimerais concevoir une plateforme sur mesure similaire pour mon domaine. Pouvons-nous échanger ?'
    }
  ];

  // Options de services dans "Et le vôtre ?" (Structure 2 colonnes comme Aquidev)
  const serviceOptions = [
    {
      key: 'saas',
      shortTitle: 'SaaS',
      title: 'SaaS / Plateforme Web',
      desc: 'Application web sur mesure, architecture modulaire MVC, authentification sécurisée et base relationnelle.',
      icon: Terminal,
      whatsappText: "Bonjour Farel, je souhaite développer une plateforme web / SaaS sur mesure. Pouvons-nous échanger sur le cahier des charges ?"
    },
    {
      key: 'vitrine',
      shortTitle: 'Vitrine',
      title: 'Site Vitrine Haut de Gamme',
      desc: 'Présence en ligne d’exception, fluidité extrême, SEO technique et mise en valeur soignée de votre marque.',
      icon: Monitor,
      whatsappText: "Bonjour Farel, je vous contacte pour concevoir un site vitrine haut de gamme et performant."
    },
    {
      key: 'mobile',
      shortTitle: 'Mobile',
      title: 'Application Mobile & PWA',
      desc: 'Interfaces tactiles ultra-rapides, adaptées aux usages smartphones avec synchronisation backend temps réel.',
      icon: Smartphone,
      whatsappText: "Bonjour Farel, j’ai besoin d'une application mobile réactive avec API backend."
    },
    {
      key: 'ecommerce',
      shortTitle: 'E-commerce',
      title: 'E-commerce & Paiements',
      desc: 'Boutique en ligne avec gestion de catalogue, passerelles de paiement (Mobile Money, Cartes) et suivi des commandes.',
      icon: ShoppingBag,
      whatsappText: "Bonjour Farel, j’ai un projet d'e-commerce avec paiement en ligne. J’aimerais échanger sur sa réalisation."
    },
    {
      key: 'ia',
      shortTitle: 'IA',
      title: 'IA & Automatisation',
      desc: 'Intégration d’agents IA, modèles de langage et automatisation intelligente de vos workflows métier.',
      icon: Sparkles,
      whatsappText: "Bonjour Farel, je souhaite intégrer de l'IA et de l'automatisation dans mes processus de travail."
    },
    {
      key: 'design',
      shortTitle: 'Architecture',
      title: 'Architecture & Backend',
      desc: 'Conception logicielle sous Laravel/Node, modélisation relationnelle SQL et sécurisation des flux de données.',
      icon: Layers,
      whatsappText: "Bonjour Farel, je recherche un ingénieur pour concevoir l’architecture backend et les bases de données de mon projet."
    }
  ];

  // Témoignages clients avec vraies photos (style Aquidev)
  const clientReviews = [
    {
      name: 'Aline D.',
      role: 'Product Manager',
      company: 'Digital Solutions',
      avatar: 'https://images.unsplash.com/photo-1531123897727-8f129e1688ce?auto=format&fit=crop&w=200&h=200&q=80',
      comment: 'Farel a fait preuve d’une excellente rigueur sur l’architecture logicielle et la modélisation des données. Les délais ont été parfaitement respectés, la communication est limpide et le code est d’une grande clarté.',
      rating: 5
    },
    {
      name: 'Marc E.',
      role: 'Directeur Technique',
      company: 'PropTech Venture',
      avatar: 'https://images.unsplash.com/photo-1506277886164-e25aa3f4ef7f?auto=format&fit=crop&w=200&h=200&q=80',
      comment: 'Une compréhension très rapide des enjeux métier. L’implémentation du backend sous Laravel et les tests d’intégration ont permis de sécuriser le projet dès les premières itérations.',
      rating: 5
    },
    {
      name: 'Dr. K. Mensah',
      role: 'Consultant Stratégie',
      company: 'Cabinet Foncier & Tech',
      avatar: 'https://images.unsplash.com/photo-1522529599102-193c0d76b5b6?auto=format&fit=crop&w=200&h=200&q=80',
      comment: 'L’approche adoptée sur la plateforme LandSafe démontre une maîtrise remarquable des problématiques du terrain combinée à une belle exigence d’ingénierie logicielle.',
      rating: 5
    },
    {
      name: 'Sarah B.',
      role: 'Fondatrice',
      company: 'Studio Nova',
      avatar: 'https://images.unsplash.com/photo-1589156280159-27698a70f29e?auto=format&fit=crop&w=200&h=200&q=80',
      comment: 'Très impressionnée par la proactivité de Farel et son sens du détail. Chaque composant est optimisé et l’expérience utilisateur finale est irréprochable.',
      rating: 5
    }
  ];

  const currentService = serviceOptions.find(s => s.key === selectedService) || serviceOptions[0];

