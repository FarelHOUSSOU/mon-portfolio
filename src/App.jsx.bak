          <nav className="flex items-center gap-7 text-xs font-mono font-bold tracking-wider text-signal-dark">
            <a href="#projets" className="hover:text-signal-blue transition-colors interactive-lift">
              Projets
            </a>
            <a href="#apropos" className="hover:text-signal-blue transition-colors interactive-lift">
              À propos
            </a>
            <a href="#formations" className="hover:text-signal-blue transition-colors interactive-lift">
              Formations
            </a>
          </nav>

          {/* CTA WhatsApp interactif */}
          <button
            onClick={() => openWhatsAppWith(defaultHeroMessage)}
            className="btn-magnetic flex items-center gap-2 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-mono font-semibold px-4 py-2 rounded-full shadow-sm"
          >
            <span className="relative flex h-2 w-2">
              <span className="animate-ping absolute inline-flex h-full w-full rounded-full bg-white opacity-75"></span>
              <span className="relative inline-flex rounded-full h-2 w-2 bg-white"></span>
            </span>
            <MessageCircle className="w-3.5 h-3.5" />
            <span>WhatsApp</span>
          </button>
        </div>
      </header>

      {/* HEADER MOBILE EN HAUT — Compact, sans chevauchement, adapté à tous les écrans */}
      <nav
        aria-label="Navigation mobile"
        className={`md:hidden fixed inset-x-0 top-0 z-[9999] transition-all duration-300 safe-pt-mobile px-3 pb-2.5 ${
          navScrolled
            ? 'bg-signal-bg/95 backdrop-blur-xl border-b border-signal-border shadow-sm'
            : 'bg-signal-bg/90 backdrop-blur-md border-b border-signal-border/50'
